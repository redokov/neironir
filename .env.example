# neironir local configuration. Copy to `.env` and adjust as needed.
# All variables are prefixed with NEIRONIR_; see backend/neironir/config.py.

# HTTP server
NEIRONIR_HOST=127.0.0.1
NEIRONIR_PORT=8000

# Where per-job files are kept (relative paths resolve from the repo root).
NEIRONIR_STORAGE_DIR=./storage

# Max accepted upload size, in bytes (20 MiB by default).
NEIRONIR_MAX_FILE_SIZE=20971520

# Privacy-filter integration. Default ``combined`` uses the neural model
# via subprocess **plus** rule-based heuristics (recommended).  Use
# ``mock`` for development/testing without the model (regex heuristics
# only).  See docs/quickstart.md for setup instructions.
NEIRONIR_PRIVACY_FILTER_MODE=combined
NEIRONIR_PRIVACY_FILTER_CMD=python -m opf
NEIRONIR_PRIVACY_FILTER_TIMEOUT=600
NEIRONIR_PRIVACY_FILTER_DEVICE=cpu
# Leave empty to use opf's own default (OPF_CHECKPOINT env or ~/.opf/privacy_filter).
NEIRONIR_PRIVACY_FILTER_CHECKPOINT_DIR=

# Static frontend directory served at /static and /.
NEIRONIR_FRONTEND_DIR=frontend

# Logging level for the backend process.
NEIRONIR_LOG_LEVEL=INFO

# Admin training: where JSONL datasets and fine-tuned checkpoints are
# written.  Leave empty to default to ``<storage_dir>/checkpoints``.
NEIRONIR_ADMIN_TRAINING_OUTPUT_DIR=
NEIRONIR_ADMIN_TRAINING_MAX_RECORDS=100000

# ---- Authentication (variant C: login + signed session cookie) ----
# Secret used to HMAC-sign the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — the server will refuse to start if this is empty.
NEIRONIR_SESSION_SECRET=

# Admin credentials for the login form. Both required.
# WARNING: keep the password secret; never commit it to version control.
NEIRONIR_ADMIN_USER=admin
NEIRONIR_ADMIN_PASSWORD=

# Session lifetime, in seconds (default 24h).
# NEIRONIR_SESSION_MAX_AGE=86400
